NODE_ENV=development
PORT=3000

# Project Settings > API en el dashboard de Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave "anon" (o "publishable"). NO uses service_role en este backend.
SUPABASE_ANON_KEY=

# 32 bytes en base64:  openssl rand -base64 32
# Si se pierde, los desahogos existentes quedan IRRECUPERABLES.
ENCRYPTION_KEY=

# Orígenes permitidos (CORS), separados por coma. Vacío = ninguno.
CORS_ORIGINS=http://localhost:5173
