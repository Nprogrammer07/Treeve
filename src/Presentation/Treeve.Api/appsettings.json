{
  "Logging": {
    "Console": {
      "FormatterOptions": {
        "IncludeScopes": true
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Persistencia": {
    "AplicarMigraciones": false
  },
  "EspacioVerde": {
    "DesahogosPorCrecimiento": 3
  },
  "Cors": {
    "Origenes": []
  },
  "AllowedHosts": "*"
}
