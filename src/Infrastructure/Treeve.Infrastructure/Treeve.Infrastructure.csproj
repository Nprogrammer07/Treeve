<Project Sdk="Microsoft.NET.Sdk">
  <!-- Anillo externo · Infraestructura: implementa las interfaces del núcleo
       (repositorios, cifrado, bus de eventos). No conoce la presentación. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\Treeve.Application\Treeve.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- ADR-001: el contenido de los mensajes de apoyo es JSON versionado y viaja dentro del ensamblado. -->
    <EmbeddedResource Include="MensajesApoyo\Contenido\*.json" LogicalName="Treeve.Infrastructure.MensajesApoyo.Contenido.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Las pruebas del cifrador, del hash de contraseñas y del contenido de los mensajes usan las clases internas. -->
    <InternalsVisibleTo Include="Treeve.Infrastructure.Tests" />
  </ItemGroup>
</Project>
